# ML training dumps and demo frames (not the shipped weights)
drone-airspace-guardian/ml/vision_frames/
drone-airspace-guardian/ml/yolo_data/
drone-airspace-guardian/ml/runs/

# YOLO checkpoints. Training dumps and the stock COCO net stay out.
# ml/weights/yolov8n_airspace.pt is 5.92 MB, so the trained bundle is commitable.
*.pt
!drone-airspace-guardian/ml/weights/
!drone-airspace-guardian/ml/weights/*.pt

# AU-AIR camera frames are exported locally (its licence asks for links, not rebundling);
# the OpenStreetMap response cache is re-fetchable by ml/build_airspace.py.
drone-airspace-guardian/ml/auair_frames/
drone-airspace-guardian/ml/.cache/

# Ultralytics writes val runs wherever it is launched from.
/runs/
